@using FSNotes.UI.Features.Structure.Contexts
@using FSNotes.UI.Features.Structure.Services
@inject IStructureService StructureService
@implements IDisposable

<CascadingValue Value="context">
    <div class="container" >
        @foreach (var entity in context?.Structures ?? [])
        {
            <StructureEntityComponent @key="entity.Id" Entity="entity" />
        }
    </div>
</CascadingValue>

@code {
    IStructureContext? context;

    protected override async Task OnInitializedAsync()
    {
        context = new StructureContext(StructureService);
        context.Changed += onContextChanged;

        await context.Reload();
    }

    void onContextChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (context is not null)
        {
            context.Changed -= onContextChanged;
        }
    }
}
