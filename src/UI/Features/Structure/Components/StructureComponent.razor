@using FSNotes.UI.Features.Structure.Contexts
@using FSNotes.UI.Features.Structure.Services
@inject IStructureService StructureService
@implements IDisposable

<CascadingValue Value="context">
    <div class="container" >
        <div class="actions">
            <FsContextMenu CloseOnContentClick="true" Class="context-menu">
                <Icon><Plus /></Icon>
                <ChildContent>
                    <div class="plus-container">
                        <div @onclick="newFolder" role="menuitem">New Folder</div>
                        <div>New Note</div>
                    </div>
                </ChildContent>
            </FsContextMenu>
        </div>
        <NewFolder @ref="newFolderRef" OnNewFolder="handleNewFolder" />
        @foreach (var entity in context?.Structures ?? [])
        {
            <StructureEntityComponent @key="entity.Id" Entity="entity" />
        }
    </div>
</CascadingValue>

@code {
    IStructureContext? context;
    private NewFolder newFolderRef = default!;

    protected override async Task OnInitializedAsync()
    {
        context = new StructureContext(StructureService);
        context.Changed += onContextChanged;

        await context.Reload();
    }
    async Task newFolder()
    {
        if (newFolderRef is not null)
        {
            newFolderRef.Show();
        }
    }

    async Task handleNewFolder(string folderName)
    {
        if (!string.IsNullOrWhiteSpace(folderName))
        {
            await StructureService.AddFolder(folderName, "");

            if (context is not null)
            {
                await context.Reload();
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    void onContextChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (context is not null)
        {
            context.Changed -= onContextChanged;
        }
    }
}
