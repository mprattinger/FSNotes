@using FSNotes.UI.Features.Structure.Models
@using FlintSoft.Components
@using FlintSoft.Components.Icons

<div class="container" style="margin-left: @(Entity.Level * 1)rem;">
    <div class="line">
        @if (canExpand())
        {
            <div class="expand" @onclick="toggleExpand">
                @if (show)
                {
                    <DownChevron />
                }
                else
                {
                    <RightChevron />
                }
            </div>
        } else
        {
            <div class="noexpand"></div>
        }
        <span>@Entity.Name</span>
        <div class="actions">
            <FsContextMenu>
                <Icon><Plus /></Icon>
                <ChildContent>
                    <FsButton Compact>New Folder</FsButton>
                    <FsButton Compact>New Note</FsButton>
                </ChildContent>
            </FsContextMenu>
            <Ellipsis />
        </div>
    </div>
    @if (show)
    {
        @if (Entity.Children != null && Entity.Children.Count > 0)
        {
            <div class="child-container">
                @foreach (var child in Entity.Children)
                {
                    <StructureEntityComponent Entity="child" />
             
                }
            </div>
        }
    }
</div>

@code {
    bool show = false;

    [Parameter, EditorRequired]
    public StructureEntity Entity { get; set; } = default!;

    bool canExpand()
    {
        return Entity.Children.Count() > 0 && Entity.Type == StructureType.Folder;
    }

    void toggleExpand()
    {
        show = !show;
    }
}
