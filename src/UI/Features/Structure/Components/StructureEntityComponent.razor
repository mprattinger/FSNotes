@using FSNotes.UI.Common.Contexts
@using FSNotes.UI.Features.Storage.Models
@using FSNotes.UI.Features.Storage.Services
@inject IStorageService StorageService

<div class="container" style="margin-left: @(Entity.Level * 1)rem;">
    <div class="line">
        @if (canExpand())
        {
            <div class="expand" @onclick="toggleExpand">
                @if (show)
                {
                    <DownChevron />
                }
                else
                {
                    <RightChevron />
                }
            </div>
        }
        else
        {
            <div class="noexpand"></div>
        }
        <span>@Entity.Name</span>
        <div class="actions">
            <FsContextMenu CloseOnContentClick="true" Class="context-menu">
                <Icon><Plus /></Icon>
                <ChildContent>
                    <div class="plus-container">
                        <div @onclick="newFolder" role="menuitem">New Folder</div>
                        <div>New Note</div>
                    </div>
                </ChildContent>
            </FsContextMenu>
            <Ellipsis />
        </div>
    </div>
    @if (show)
    {
        @if (Entity.Children != null && Entity.Children.Count > 0)
        {
            <div class="child-container">
                @foreach (var child in Entity.Children)
                {
                    <StructureEntityComponent Entity="child" />
             
                }
            </div>
        }
    }
</div>
<NewFolder @ref="newFolderRef" OnNewFolder="handleNewFolder" />

@code {
    bool show = false;
    private NewFolder newFolderRef = default!;

    [CascadingParameter]
    public ApplicationContext? Context { get; set; }

    [Parameter, EditorRequired]
    public StorageNode Entity { get; set; } = default!;



    bool canExpand()
    {
        return Entity.Children.Count() > 0 && Entity.IsFile == false;
    }

    void toggleExpand()
    {
        show = !show;

    }

    async Task newFolder()
    {
        if (newFolderRef is not null)
        {
            await newFolderRef.ShowAsync();
        }
    }

    async Task handleNewFolder(string folderName)
    {
        if (!string.IsNullOrWhiteSpace(folderName))
        {
            StorageService.CreateFolder(folderName, Entity.FullPath);

            if (Context is not null)
            {
                Context.NotifyStorageUpdated();
            }

            await InvokeAsync(StateHasChanged);
        }
    }
}
